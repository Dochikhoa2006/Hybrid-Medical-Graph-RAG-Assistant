# Password used by Knowledge_Graph.py when connecting to Neo4j.
# Replace this value locally and keep the real .env file out of Git.
# The Docker Compose file currently contains its own demonstration credential.
AUTH=replace-with-a-local-neo4j-password

# Optional: Docker Compose reads this value for both query processing and answers.
# For a direct Python run, export OLLAMA_MODEL in the shell. Pull the model first.
OLLAMA_MODEL=qwen2.5:0.5b-instruct-q5_k_m
